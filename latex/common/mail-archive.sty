\renewcommand{\familydefault}{\sfdefault}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}
\raggedbottom
\pagestyle{fancy}\fancyhf{}
\fancyhead[L]{\scriptsize Half-A/Labs\quad /\quad retained correspondence}
\fancyhead[R]{\scriptsize Blender-8}
\fancyfoot[L]{\scriptsize Printed from the project mail file\quad |\quad Times shown in Central Time}
